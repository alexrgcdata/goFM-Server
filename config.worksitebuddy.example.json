{
  "address": "127.0.0.1:8080",
  "base_path": "/openbridge/go",
  "token_env": "GOFM_APP_TOKEN",
  "admin_token_env": "GOFM_ADMIN_TOKEN",
  "cors_origins": ["https://worksitebuddy.com", "https://www.worksitebuddy.com"],
  "security": {
    "max_request_body_bytes": 1048576,
    "rate_limit_per_minute": 120,
    "upstream_timeout_seconds": 30,
    "allowed_upstream_hosts": []
  },
  "logs": {
    "max_entries": 50,
    "file": "logs/requests.enc",
    "encryption_key_env": "GOFM_LOG_KEY",
    "capture_body_preview": false
  },
  "storage": { "db_file": "data/gofm.sqlite" },
  "credentials": {
    "file": "secrets/credentials.enc",
    "encryption_key_env": "GOFM_VAULT_KEY"
  },
  "filemaker_connections": [],
  "routes": []
}
